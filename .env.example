# Target site — demo uses books.toscrape.com (a site made for scraping practice).
# For real jobs: verify robots.txt + ToS BEFORE changing this.
TARGET_URL=https://books.toscrape.com/catalogue/page-1.html

# Polite scraping
USER_AGENT=Mozilla/5.0 (compatible; portfolio-demo-scraper/0.1)
SCRAPE_DELAY_SECONDS=2
MAX_PAGES=3

# Output
OUTPUT_DIR=data/output
OUTPUT_FORMAT=csv     # csv | excel

# Logging
LOG_LEVEL=INFO
